{
  "name": "blockwright",
  "version": "0.7.0",
  "private": true,
  "description": "Deterministic Minecraft build architect and ChatGPT MCP App",
  "license": "GPL-2.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev-fixed.ts",
    "dev:tunnel": "tsx scripts/dev-fixed.ts --tunnel",
    "build": "skybridge build && npm run build:standalone",
    "build:standalone": "vite build --config vite.standalone.config.ts",
    "package:plugin": "node scripts/package-plugin.mjs",
    "package:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/release/Build-BlockwrightWindowsRelease.ps1",
    "package:windows:portable": "node scripts/release/build-windows-release.mjs",
    "release:sbom": "node scripts/release/generate-sbom.mjs",
    "release:checksums": "node scripts/release/write-checksums.mjs",
    "release:verify": "node scripts/release/verify-release.mjs",
    "test:release": "node --test scripts/release/*.node-test.mjs",
    "start": "skybridge start",
    "deploy": "alpic deploy",
    "sample": "tsx scripts/generate-sample.ts",
    "benchmark:v060": "tsx scripts/benchmark-v060.ts",
    "diagnose": "node scripts/diagnose.mjs",
    "install:runtime": "npm ci --omit=dev --no-audit --no-fund --prefer-offline --prefix app",
    "verify": "npm run build && npm test && npm run package:plugin && npm run verify:runtime-lock && npm run install:runtime && npm run diagnose",
    "verify:packaged-sync": "node scripts/verify-packaged-sync.mjs",
    "verify:runtime-lock": "node scripts/verify-runtime-lock.mjs",
    "check:java": "tsx scripts/sync-java-version.ts --check",
    "sync:java": "tsx scripts/sync-java-version.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@minecraft/vanilla-data": "^1.26.44",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.542.0",
    "minecraft-data": "^3.115.0",
    "prismarine-nbt": "^2.8.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "skybridge": "^1.4.1",
    "three": "^0.179.1",
    "vite": "^8.1.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@skybridge/devtools": "^1.2.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.179.0",
    "alpic": "^1.155.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.23.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
